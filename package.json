{
  "name": "secret-shield",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local prompt redaction for ChatGPT and Claude in Chrome",
  "engines": { "node": "24.x" },
  "scripts": {
    "build": "node scripts/build.mjs",
